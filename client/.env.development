# Used automatically by "npm run dev". This file IS committed on purpose:
# it holds no secret, and it means the project runs after a fresh clone.
#
# Vite only exposes variables whose name starts with VITE_, and it bakes their
# values into the bundle at build time.
VITE_API_URL=http://localhost:5000

# Optional: the Atlas Charts embed URL. Leave empty to hide that panel.
VITE_ATLAS_CHART_URL=
