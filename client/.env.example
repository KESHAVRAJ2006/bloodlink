# Reference copy of the client environment variables.
#
# Local development already works without any action: .env.development is
# committed and points at http://localhost:5000.
#
# For the deployed site do NOT create a .env.production file. Add these in the
# Vercel dashboard instead (Settings > Environment Variables), then redeploy -
# Vite substitutes VITE_ variables at BUILD time, so a changed value only takes
# effect after a new build.
#
# Never put a secret in a VITE_ variable: it is readable in the browser bundle.

# The base URL of the API. On Vercel this is the Render URL, with https and no
# trailing slash.
VITE_API_URL=https://bloodlink-api.onrender.com

# Optional: the embed URL of the MongoDB Atlas chart shown on the dashboard.
VITE_ATLAS_CHART_URL=
