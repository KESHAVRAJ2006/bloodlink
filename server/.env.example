# Copy this file to .env and fill in your own values.
# .env is in .gitignore and must never be committed. These are the same
# variables you add in the Render dashboard under Environment.

# Atlas connection string for the application user, without a database name.
MONGO_URI=mongodb+srv://bloodlink_app:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=bloodlink

# Any long random string. Anyone who knows it can forge a login token.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Local port. Render ignores this and injects its own PORT, which the code reads.
PORT=5000

# Which browser origins may call this API, comma separated, no trailing slash.
# Locally just the Vite dev server; in production add the Vercel URL as well:
#   CLIENT_URL=http://localhost:5173,https://bloodlink-xyz.vercel.app
# An entry may start with *. to allow a whole subdomain, e.g. *.vercel.app
CLIENT_URL=http://localhost:5173
