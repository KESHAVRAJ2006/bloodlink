{
  "compilerOptions": {
    "target": "ES2022",

    /* The package is "type": "module", so the build has to emit real ESM.
       NodeNext tells TypeScript to resolve and emit the way Node does, which is
       why every local import in src/ ends with .js even though the files are
       .ts - the extension in the import is the one that exists after the
       build, not before it. */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],

    /* Output: src/index.ts becomes dist/index.js, which is what npm start runs. */
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "declaration": false,
    "removeComments": false,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
