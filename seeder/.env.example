# Copy this file to .env and paste your own Atlas connection string.
# The seeder runs from your laptop, never from Render, so this .env stays local.
# Keep the database name out of the URI, DB_NAME below decides it.
MONGO_URI=mongodb+srv://bloodlink_app:YOUR_PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
DB_NAME=bloodlink
